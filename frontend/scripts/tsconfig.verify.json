{
  "compilerOptions": {
    "outDir": "../node_modules/.cache/verify",
    "rootDir": "..",
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["./verify-nesting.ts"]
}
